# velgix 🇧🇪

Couteau suisse Python pour la Belgique.

## Installation

```bash
pip install velgix
from velgix import holidays

feries = holidays.feries(2026)
# {'Nouvel An': date(2026, 1, 1), 'Lundi de Paques': date(2026, 4, 6), ...}

holidays.est_ferie(date(2026, 7, 21))  # True
from velgix import numbers

numbers.tva_valide("BE0411905847")      # True
numbers.tva_valide("BE1234567890")      # False
numbers.niss_valide("85031512345")      # True/False
from velgix import postal

postal.ville("1000")        # "Bruxelles"
postal.province("8000")     # "Flandre-Occidentale"
postal.codes("Bruxelles")   # ["1000"]
pytest

